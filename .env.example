# 推荐用交互式命令填写：uv run cuemem configure（Key 输入时不显示，自动写入 .env）。
# 也可以复制本文件为 .env 后手动填写。.env 已在 .gitignore 中，不会被提交。

DEEPSEEK_API_KEY=

# QwenCloud（通义千问国际版）的 Key，以 sk-ws- 开头，在 https://home.qwencloud.com/api-keys 创建
DASHSCOPE_API_KEY=

# 如果改用中国大陆的千问 AI 平台（或阿里云百炼），覆盖下面两个接口地址，并换成对应平台的 Key：
# CUEMEM_PROVIDERS__QWEN__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# CUEMEM_EMBEDDING__NATIVE_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding

# 任何配置项都可以用环境变量覆盖：前缀 CUEMEM_，嵌套用双下划线。例如：
# CUEMEM_ROLES__READER__MODEL=qwen3.8-flash
# CUEMEM_EMBEDDING__BACKEND=hash        # 离线哈希向量，无需 Key（仅用于测试与演示）

# 换模型供应商（N12）：预设叠加在默认配置上，只需要对应的 Key
# CUEMEM_PRESET=openai                  # 全部换成 OpenAI，需要 OPENAI_API_KEY
# CUEMEM_PRESET=ollama                  # 全部跑在本机的 Ollama，不需要 Key
OPENAI_API_KEY=

# 数据目录（数据库、向量库、缓存、原图，以及这个 .env 本身）用环境变量 CUEMEM_HOME 指定，
# 要在 shell 里设置、不能写在这里：源码仓库里默认是仓库根目录，pip 安装后默认 ~/.cuemem

# HTTP 接口、界面与记忆代理的访问令牌。cuemem serve / proxy 监听非本机地址时必须设置（Docker
# 镜像与 docker compose 也是），否则拒绝启动；可以用 openssl rand -hex 32 生成
# CUEMEM_API_TOKEN=

# 多租户：限定作用域的令牌，每个只能访问列出的用户（与 Agent）的记忆。YAML 文件的路径（Docker 里
# 放在 /data 下），或者直接写同样内容的 YAML / JSON（两者只能设一个）。格式：
#   keys:
#     - {name: alice-app, sha256: <printf %s "$TOKEN" | sha256sum>, scopes: [{user: alice}]}
#     - {name: shop-backend, sha256: <...>, scopes: [{user: "*", agent: shop}, {agent: shop}]}
# CUEMEM_API_KEYS_FILE=
# CUEMEM_API_KEYS=

# trace（runs/traces 下按天的 JSONL，属性里有提问的原话）保留几天：cuemem serve / proxy 启动时与
# 之后每天删一遍更早的文件，连同其中提问的查询向量。不设时一直留着
# CUEMEM_TRACES_RETENTION_DAYS=30

# 后台巩固同时处理几个用户（记忆空间）的抽取，缺省 4；同一空间仍一次一个。发给模型供应商的请求
# 另有每家的并发上限；同时巩固的空间各占一份载入的事实与实体
# CUEMEM_CONSOLIDATION__BACKGROUND_WORKERS=4

# /api 与 /v1 不接受别的网站发来的浏览器请求；监听本机地址时还只接受 Host 为 127.0.0.1、localhost、
# [::1] 的请求（防 DNS 重绑定）。经反向代理或别的主机名访问时在这里列出（逗号分隔；* 表示都不检查）
# CUEMEM_ALLOWED_HOSTS=
