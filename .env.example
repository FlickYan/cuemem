# 推荐用交互式命令填写：uv run cuemem configure（Key 输入时不显示，自动写入 .env）。
# 也可以复制本文件为 .env 后手动填写。.env 已在 .gitignore 中，不会被提交。

DEEPSEEK_API_KEY=

# QwenCloud（通义千问国际版）的 Key，以 sk-ws- 开头，在 https://home.qwencloud.com/api-keys 创建
DASHSCOPE_API_KEY=

# 如果改用中国大陆的千问 AI 平台（或阿里云百炼），覆盖下面两个接口地址，并换成对应平台的 Key：
# CUEMEM_PROVIDERS__QWEN__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# CUEMEM_EMBEDDING__NATIVE_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding

# 任何配置项都可以用环境变量覆盖：前缀 CUEMEM_，嵌套用双下划线。例如：
# CUEMEM_ROLES__READER__MODEL=qwen3.8-flash
# CUEMEM_EMBEDDING__BACKEND=hash        # 离线哈希向量，无需 Key（仅用于测试与演示）
